<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="IDHEXMobApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:IDHEXMobApp.Views"
    Shell.FlyoutBehavior="Disabled">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        Route="LoginPage"
        Shell.NavBarIsVisible="False" />

    <TabBar>
        <ShellContent
            Title="Home"
            Icon="hometab"
            ContentTemplate="{DataTemplate views:PrincipalPage}"
            Route="PrincipalPage" />
        
        <ShellContent
            Title="Romaneios"
            Icon="romaneios"
            ContentTemplate="{DataTemplate views:PedidosPage}"
            Route="PedidosPage" />

        <ShellContent
            Title="Notas"
            Icon="notas"
            ContentTemplate="{DataTemplate views:NotasPage}"
            Route="NotasPage" />

        <ShellContent
            Title="Lista Baixas"
            Icon="download"
            ContentTemplate="{DataTemplate views:PedidosBaixaPage}"
            Route="PedidosBaixaPage" />
    </TabBar>
</Shell>